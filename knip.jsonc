// Adapted from mars-workbench@3f741cc knip.jsonc.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // An export its own file still uses isn't dead code.
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // postcss.config.mjs is loaded by Next's own bundled PostCSS.
    "postcss",
  ],
}
