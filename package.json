{
  "name": "mars-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:themes": "node scripts/check-theme-vars.mjs",
    "check:review-log": "node scripts/check-review-log.mjs",
    "check:spec": "node scripts/checkSpec.mts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "knip": "5.88.1",
    "prettier": "3.9.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "browserslist": "> 1%"
}
